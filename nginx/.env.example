# Copy to .env and edit. Docker Compose reads this file automatically.
#   cp .env.example .env

# ORIGIN_URL (the site to protect) is set in docker-compose-nginx.yaml, in the botlocker service.

# Host name nginx answers to. "_" accepts any host name.
SERVER_NAME=_

# Port on your machine that forwards to the proxy.
HOST_PORT=8080

# Optional live dashboard, in the same container. Off by default.
# To turn it on, set BOTLOCKER_DASHBOARD=on and a key below, then restart the stack.
# Open http://localhost:9090. No key is needed in the browser: the server uses BOTLOCKER_ADMIN_APIKEY.
BOTLOCKER_DASHBOARD=off
# DASHBOARD_PORT=9090            # published to 127.0.0.1 only
# EVENT_LOG_FILE=/var/log/botlocker/events.jsonl   # set automatically when the dashboard is on

# API key for the dashboard. Required when BOTLOCKER_DASHBOARD=on. Generate with: openssl rand -hex 32
BOTLOCKER_ADMIN_APIKEY=
